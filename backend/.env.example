# Vivara — Backend Environment Configuration

# ─── LLM / AI Router ─────────────────────────────────────────────────────────
# Options: omniroute (recommended), auto, ollama, openai_compat, lm_studio, vllm, openrouter, custom
LLM_PROVIDER=omniroute

# OmniRoute (default) — OpenAI-compatible universal router
LLM_BASE_URL=http://localhost:7777/v1
LLM_API_KEY=
LLM_MODEL=auto

# For direct Ollama:   LLM_BASE_URL=http://localhost:11434, LLM_MODEL=llama3.2
# For OpenRouter:      LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY=your_key
# For LM Studio:       LLM_BASE_URL=http://localhost:1234/v1
# For vLLM:            LLM_BASE_URL=http://localhost:8080/v1

# ─── Text-to-Speech ───────────────────────────────────────────────────────────
# Options: kokoro (offline, recommended), edge_tts (online fallback)
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
EDGE_TTS_VOICE=en-US-JennyNeural

# ─── Stock Media APIs (OPTIONAL — app works without these) ────────────────────
# Get a free Pexels API key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Get a free Pixabay API key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ─── System & Storage ────────────────────────────────────────────────────────
STORAGE_DIR=../storage
FFMPEG_PATH=ffmpeg

# GPU acceleration (NVENC for NVIDIA, AMF for AMD, auto-detected)
GPU_ENABLED=true

# ─── Whisper (Subtitles) ─────────────────────────────────────────────────────
# Options: tiny (fastest), base (recommended), small, medium (most accurate)
WHISPER_MODEL=base
